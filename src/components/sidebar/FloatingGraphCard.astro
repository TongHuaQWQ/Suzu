---
import type { GraphNode, GraphEdge } from "../../utils/graph";

interface Props {
  nodes: GraphNode[];
  edges: GraphEdge[];
  currentSlug?: string;
}
const { nodes, edges, currentSlug } = Astro.props;
---

{
  nodes.length > 0 && (
    <div class="">
      <div
        id="float-graph-container"
        class="w-full h-64 min-h-64 rounded-lg overflow-hidden bg-(--md-surface) cursor-grab active:cursor-grabbing"
        data-nodes={JSON.stringify(nodes)}
        data-edges={JSON.stringify(edges)}
        data-current={currentSlug || ""}
      />
    </div>
  )
}

<script>
  import ForceGraph from "force-graph";

  function getCSSVar(name: string): string {
    return (
      getComputedStyle(document.documentElement)
        .getPropertyValue(name)
        .trim() || ""
    );
  }

  function getConnectedNodes(nodes: any[], edges: any[], currentSlug: string) {
    const currentId = currentSlug.replace(/^\/posts\//, "");
    const connected = new Set<string>();
    connected.add(currentId);
    for (const e of edges) {
      if (typeof e.source === "string" && e.source === currentId)
        connected.add(e.target);
      if (typeof e.target === "string" && e.target === currentId)
        connected.add(e.source);
    }
    // 如果没有连接节点（除了自己），返回空
    if (connected.size <= 1) {
      return { nodes: [], edges: [] };
    }
    return {
      nodes: nodes.filter((n) => connected.has(n.id)),
      edges: edges.filter(
        (e) =>
          connected.has(
            typeof e.source === "string" ? e.source : e.source?.id,
          ) &&
          connected.has(typeof e.target === "string" ? e.target : e.target?.id),
      ),
    };
  }

  let graphInstance: any = null;

  function createGraph(
    container: HTMLElement,
    nodes: any[],
    edges: any[],
    currentSlug: string,
  ) {
    const currentId = currentSlug.replace(/^\/posts\//, "");
    const data = getConnectedNodes(nodes, edges, currentSlug);

    // 无连接 — 隐藏卡片
    if (data.nodes.length === 0) {
      container.closest(".card")?.classList.add("hidden");
      return;
    }

    const primary = getCSSVar("--md-primary") || "#8b2671";
    const primaryContainer = getCSSVar("--md-primary-container") || "#ffd7ee";
    const outline = getCSSVar("--md-outline") || "#847379";
    const onSurface = getCSSVar("--md-on-surface") || "#22191d";
    const onSurfaceVar = getCSSVar("--md-on-surface-variant") || "#524148";

    graphInstance = ForceGraph()(container)
      .width(container.clientWidth)
      .height(container.clientHeight)
      .backgroundColor("transparent")
      .nodeCanvasObjectMode(() => "after")
      .nodeCanvasObject(
        (node: any, ctx: CanvasRenderingContext2D, globalScale: number) => {
          const label = node.title;
          const fontSize = 11 / globalScale;
          ctx.font = `${fontSize}px ui-sans-serif, system-ui, sans-serif`;
          ctx.textAlign = "center";
          ctx.textBaseline = "top";
          ctx.fillStyle = node.id === currentId ? onSurface : onSurfaceVar;
          ctx.fillText(label, node.x, node.y + 8 + 4 / globalScale);
        },
      )
      .nodeColor((node: any) => {
        if (node.id === currentId) return primary;
        const connected = data.edges.some(
          (e) =>
            (typeof e.source === "string" ? e.source : e.source?.id) ===
              currentId ||
            (typeof e.target === "string" ? e.target : e.target?.id) ===
              currentId,
        );
        return connected ? primaryContainer : outline + "60";
      })
      .nodeRelSize(5)
      .nodeVal((node: any) => (node.id === currentId ? 2 : 1))
      .linkColor((link: any) => {
        const src =
          typeof link.source === "string" ? link.source : link.source?.id;
        const tgt =
          typeof link.target === "string" ? link.target : link.target?.id;
        return src === currentId || tgt === currentId
          ? primary + "50"
          : outline + "25";
      })
      .linkWidth((link: any) => {
        const src =
          typeof link.source === "string" ? link.source : link.source?.id;
        const tgt =
          typeof link.target === "string" ? link.target : link.target?.id;
        return src === currentId || tgt === currentId ? 1.5 : 0.8;
      })
      .linkDirectionalParticles((link: any) => {
        const src =
          typeof link.source === "string" ? link.source : link.source?.id;
        const tgt =
          typeof link.target === "string" ? link.target : link.target?.id;
        return src === currentId || tgt === currentId ? 2 : 0;
      })
      .linkDirectionalParticleWidth(2)
      .linkDirectionalParticleSpeed(0.008)
      .linkDirectionalParticleColor(() => primary + "cc")
      .linkHoverPrecision(2)
      .enableNodeDrag(true)
      .enableZoomInteraction(true)
      .nodeLabel((node: any) => node.title)
      .onNodeHover((node: any) => {
        container.style.cursor = node ? "grab" : "";
      })
      .onNodeClick((node: any) => {
        window.location.href = node.slug;
      })
      .d3AlphaDecay(0.03)
      .d3VelocityDecay(0.8)
      .minZoom(0.8)
      .maxZoom(5);

    graphInstance.d3Force("charge").strength(-40);
    graphInstance.d3Force("link").distance(50);

    graphInstance.graphData({
      nodes: data.nodes.map((n) => ({ ...n })),
      links: data.edges.map((e) => ({ source: e.source, target: e.target })),
    });

    // 等待力导向稳定后居中显示
    setTimeout(() => {
      try {
        const current = data.nodes.find((n) => n.id === currentId);
        if (current && typeof current.x === "number") {
          graphInstance.centerAt(current.x, current.y, 400);
          graphInstance.zoom(1.8, 400);
        } else {
          graphInstance.zoomToFit(300, 40);
        }
      } catch (e) {
        // ignore
      }
    }, 600);

    // 自适应
    const resize = () => {
      if (!graphInstance) return;
      graphInstance.width(container.clientWidth);
      graphInstance.height(container.clientHeight);
    };

    // 主题切换时重建图谱（颜色随 CSS 变量更新）
    let themeObserver = new MutationObserver(() => {
      if (!graphInstance) return;
      themeObserver.disconnect();
      graphInstance._destructor && graphInstance._destructor();
      graphInstance = null;
      createGraph(container, nodes, edges, currentSlug);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
    window.addEventListener("resize", resize);

    document.addEventListener(
      "astro:after-swap",
      () => {
        window.removeEventListener("resize", resize);
      },
      { once: true },
    );
  }

  function initGraph() {
    const container = document.getElementById("float-graph-container");
    if (!container) return;

    const nodes = JSON.parse(container.dataset.nodes || "[]");
    const edges = JSON.parse(container.dataset.edges || "[]");
    const currentSlug = container.dataset.current || "";

    // SWUP 切换后恢复可能被隐藏的卡片
    container.closest(".card")?.classList.remove("hidden");

    if (nodes.length === 0) return;

    // 等待布局稳定再初始化图谱
    let waitCount = 0;
    const waitAndInit = () => {
      if (container.clientWidth < 100 || container.clientHeight < 50) {
        if (++waitCount > 30) return; // 最多等 ~500ms
        requestAnimationFrame(waitAndInit);
        return;
      }
      // 额外延时确保布局完成
      setTimeout(() => createGraph(container, nodes, edges, currentSlug), 100);
    };
    waitAndInit();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGraph);
  } else {
    initGraph();
  }
  document.addEventListener("astro:page-load", initGraph);
</script>
