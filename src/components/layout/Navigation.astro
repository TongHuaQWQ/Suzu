---
import { Icon } from "astro-icon/components";
import { site } from "../../site.config";

interface Props {
  hideOnScroll?: boolean;
}

const { hideOnScroll } = Astro.props;
---

<nav
  id="mainNav"
  class="sticky top-0 z-30 flex p-4 items-center justify-between bg-(--md-surface-container-lowest)/80 backdrop-blur-lg rounded-2xl shadow-sm w-full transition-transform duration-300"
  data-no-swup
  data-hide-on-scroll={hideOnScroll ? "true" : "false"}
>
  <!-- 左侧：Logo/站点名称 + 汉堡菜单 -->
  <div class="flex items-center gap-1">
    <button
      id="menuToggle"
      class="md:hidden p-2 rounded-xl hover:bg-(--md-surface-container-low) active:bg-(--md-surface-container) active:scale-95 text-(--md-on-surface-variant) transition-all duration-150"
      aria-label="菜单"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <line id="menuIconTop" x1="4" y1="6" x2="20" y2="6"></line>
        <line id="menuIconMid" x1="4" y1="12" x2="20" y2="12"></line>
        <line id="menuIconBtm" x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>
    <a
      href="/"
      class="flex items-center gap-2 font-bold text-(--md-on-surface)"
    >
      <Icon name="gravity-ui:circle-fill" class="w-4 h-4 text-(--md-primary)" />
      <span>{site.title}</span>
    </a>
  </div>

  <!-- 桌面端导航链接 -->
  <ul class="hidden md:flex gap-1">
    {
      site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="px-4 py-2 rounded-xl transition-colors hover:bg-(--md-primary-container) hover:text-(--md-on-primary-container) active:bg-(--md-primary) active:text-white text-(--md-on-surface-variant)"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <!-- 右侧：图标按钮 -->
  <div class="flex gap-2 items-center">
    <button
      id="themeToggle"
      class="p-2 rounded-xl hover:bg-(--md-surface-container-low) active:bg-(--md-surface-container) active:scale-95 text-(--md-on-surface-variant) transition-all duration-150"
      aria-label="切换主题"
    >
      <Icon
        name="mingcute:moon-stars-line"
        class="w-5 h-5 theme-icon-dark block"
      />
      <Icon name="mingcute:sun-line" class="w-5 h-5 theme-icon-light hidden" />
    </button>
    <!-- 搜索容器 -->
    <div class="relative flex items-center">
      <!-- 桌面端内联搜索框 -->
      <input
        type="text"
        id="searchInput"
        placeholder="搜索文章..."
        autocomplete="off"
        class="hidden md:block w-0 opacity-0 overflow-hidden rounded-xl border border-(--md-outline-variant) bg-(--md-surface-container-low) px-0 py-2 text-base text-(--md-on-surface-variant) transition-all duration-300 ease-in-out focus:outline-none focus:ring-2 focus:ring-(--md-primary-container) peer"
      />

      <!-- 搜索按钮 -->
      <button
        id="searchBtn"
        class="ml-0 p-2 rounded-xl hover:bg-(--md-surface-container-low) active:bg-(--md-surface-container) active:scale-95 text-(--md-on-surface-variant) peer-focus:border-(--md-primary-container) transition-all duration-150"
      >
        <Icon name="mingcute:search-2-line" class="w-5 h-5" />
      </button>

      <!-- 搜索弹出面板（移动端悬浮，桌面端也作为结果容器） -->
      <div
        id="searchPanel"
        class="hidden fixed left-4 right-4 top-25 md:absolute md:left-auto md:right-0 md:top-full md:mt-6 md:w-110 z-50 bg-(--md-surface-container-lowest) rounded-xl shadow-lg border border-(--md-outline-variant)/50 overflow-hidden p-2"
      >
        <!-- 移动端输入框 -->
        <input
          type="text"
          id="mobileSearchInput"
          placeholder="搜索文章..."
          autocomplete="off"
          class="md:hidden w-full rounded-lg border border-(--md-outline-variant) bg-(--md-surface-container-low) px-3 py-2 text-sm text-(--md-on-surface) focus:outline-none focus:ring-2 focus:ring-(--md-primary-container) mb-2"
        />
        <!-- 搜索结果 -->
        <div id="searchResults" class="max-h-80 overflow-y-auto"></div>
      </div>
    </div>
  </div>

  <!-- 移动端悬浮菜单 -->
  <div
    id="mobileMenu"
    class="hidden md:hidden absolute top-full left-2 mt-2 w-48 z-50 bg-(--md-surface-container-lowest) rounded-xl shadow-lg border border-(--md-outline-variant)/50 overflow-hidden"
  >
    <div class="flex flex-col gap-0.5 p-1.5">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="block px-4 py-2.5 rounded-lg text-sm text-(--md-on-surface-variant) hover:bg-(--md-primary-container) hover:text-(--md-on-primary-container) active:bg-(--md-primary) active:text-white transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const searchBtn = document.getElementById("searchBtn")!;
  const searchInput = document.getElementById(
    "searchInput",
  ) as HTMLInputElement | null;
  const searchPanel = document.getElementById("searchPanel")!;
  const mobileSearchInput = document.getElementById(
    "mobileSearchInput",
  ) as HTMLInputElement | null;
  const resultsEl = document.getElementById("searchResults")!;
  const isMobile = () => window.innerWidth < 768;

  let isOpen = false;
  let debounceTimer: number | undefined;

  function setSearch(open: boolean) {
    isOpen = open;
    if (isMobile()) {
      searchPanel.classList.toggle("hidden", !open);
      if (open) {
        mobileSearchInput!.value = searchInput?.value || "";
        setTimeout(() => mobileSearchInput!.focus(), 50);
      }
    } else {
      searchInput!.classList.toggle("w-0", !open);
      searchInput!.classList.toggle("opacity-0", !open);
      searchInput!.classList.toggle("w-40", open);
      searchInput!.classList.toggle("px-3", open);
      searchInput!.classList.toggle("opacity-100", open);
      searchBtn.classList.toggle("ml-0", !open);
      searchBtn.classList.toggle("ml-2", open);
      if (!open) searchPanel.classList.add("hidden");
      open ? searchInput!.focus() : searchInput!.blur();
    }
  }

  function runSearch(q: string) {
    searchPanel.classList.remove("hidden");
    clearTimeout(debounceTimer);
    if (!q) {
      resultsEl.innerHTML = "";
      return;
    }
    debounceTimer = window.setTimeout(async () => {
      const pf = await new Function("url", "return import(url)")(
        "/pagefind/pagefind.js",
      );
      const { results } = await pf.search(q);
      if (!results.length) {
        resultsEl.innerHTML = `<div class="p-3 text-sm text-(--md-on-surface-variant) opacity-60">未找到结果</div>`;
        return;
      }
      const items = await Promise.all(results.map((r: any) => r.data()));
      const seen = new Set<string>();
      const deduped = items.filter((item: any) => {
        const key = item.meta?.title || item.url;
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });
      resultsEl.innerHTML = deduped
        .slice(0, 6)
        .map(
          (
            item: any,
          ) => `<a href="${item.url}" class="block p-2 rounded-lg hover:bg-(--md-surface-container) transition-colors" data-search-result>
          <div class="text-base font-bold text-(--md-on-surface)">${item.meta?.title || item.url}</div>
          <div class="text-xs text-(--md-on-surface-variant) opacity-60 line-clamp-2">${item.excerpt}</div>
        </a>`,
        )
        .join("");
    }, 200);
  }

  searchBtn.addEventListener("click", () => setSearch(!isOpen));

  document.addEventListener("click", (e) => {
    if (!isOpen) return;
    const t = e.target as Node;
    if (searchBtn.contains(t) || searchPanel.contains(t)) return;
    if (!isMobile() && searchInput?.contains(t)) return;
    setSearch(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) setSearch(false);
  });

  function onSearchInput() {
    const input = isMobile() ? mobileSearchInput : searchInput;
    runSearch(input?.value.trim() || "");
  }
  function onSearchKeydown(e: KeyboardEvent) {
    if (e.key === "Enter") onSearchInput();
  }

  searchInput?.addEventListener("input", onSearchInput);
  searchInput?.addEventListener("keydown", onSearchKeydown);
  mobileSearchInput?.addEventListener("input", onSearchInput);
  mobileSearchInput?.addEventListener("keydown", onSearchKeydown);

  resultsEl.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest(
      "[data-search-result]",
    ) as HTMLAnchorElement | null;
    if (!link) return;
    if (searchInput) searchInput.value = "";
    if (mobileSearchInput) mobileSearchInput.value = "";
    setSearch(false);
  });

  // ── 暗黑切换 ──
  const themeToggle = document.getElementById("themeToggle")!;
  const iconDark = themeToggle.querySelector(".theme-icon-dark")!;
  const iconLight = themeToggle.querySelector(".theme-icon-light")!;

  function getTheme(): string {
    const stored = localStorage.getItem("theme");
    if (stored) return stored;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function applyTheme(theme: string) {
    const isDark = theme === "dark";
    document.documentElement.classList.toggle("dark", isDark);
    iconDark.classList.toggle("hidden", isDark);
    iconLight.classList.toggle("hidden", !isDark);
    localStorage.setItem("theme", theme);
  }

  // 初始状态
  applyTheme(getTheme());

  themeToggle.addEventListener("click", () => {
    const isDark = document.documentElement.classList.contains("dark");
    applyTheme(isDark ? "light" : "dark");
  });

  // ── 移动端悬浮菜单 ──
  const menuToggle = document.getElementById("menuToggle")!;
  const menuPanel = document.getElementById("mobileMenu")!;
  let menuOpen = false;

  function setMenu(open: boolean) {
    menuOpen = open;
    menuPanel.classList.toggle("hidden", !open);
  }

  menuToggle.addEventListener("click", () => setMenu(!menuOpen));

  // 点击外部关闭
  document.addEventListener("click", (e) => {
    if (!menuOpen) return;
    const target = e.target as Node;
    if (menuToggle.contains(target) || menuPanel.contains(target)) return;
    setMenu(false);
  });

  // 点击链接后关闭
  menuPanel.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => setMenu(false));
  });

  // ── 导航栏：下滑隐藏、上滑显示 + 滚动背景 ──
  function initNavScroll() {
    const nav = document.getElementById("mainNav");
    if (!nav) return;
    const hideOnScroll = nav.getAttribute("data-hide-on-scroll") === "true";
    let lastScroll = window.scrollY;
    const scrollThreshold = 20;

    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.scrollY;

        // 背景模糊：所有页面都生效
        nav.classList.toggle("nav-scrolled", currentScroll > 10);

        // 下滑隐藏 / 上滑显示：仅文章页
        if (hideOnScroll) {
          const diff = currentScroll - lastScroll;
          if (Math.abs(diff) > scrollThreshold) {
            if (diff > 0 && currentScroll > 80) {
              nav.style.transform = "translateY(-120%)";
            } else if (diff < 0) {
              nav.style.transform = "translateY(0)";
            }
          }
        } else {
          // 非文章页：始终保持可见
          nav.style.transform = "translateY(0)";
        }

        lastScroll = currentScroll;
      },
      { passive: true },
    );
  }

  // 避免 SWUP 切换后丢失
  const existing = document.getElementById("mainNav");
  if (existing) initNavScroll();
  document.addEventListener("astro:after-swap", initNavScroll);
</script>
