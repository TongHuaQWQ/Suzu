---
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";
import type { GraphNode, GraphEdge } from "../../utils/graph";
import FloatingTocCard from "../sidebar/FloatingTocCard.astro";
import FloatingGraphCard from "../sidebar/FloatingGraphCard.astro";

interface Props {
  showHome?: boolean;
  headings?: MarkdownHeading[];
  graphNodes?: GraphNode[];
  graphEdges?: GraphEdge[];
  currentSlug?: string;
}

const { showHome, headings, graphNodes, graphEdges, currentSlug } = Astro.props;

const currentId = currentSlug?.replace(/^\/posts\//, "") || "";
const hasConnections = (graphEdges ?? []).some(
  (e) => e.source === currentId || e.target === currentId,
);
const hasToc = headings && headings.length > 0;
const hasGraph = graphNodes && graphNodes.length > 0 && hasConnections;
---

<div class="fixed right-4 bottom-6 z-50 flex flex-col items-end gap-3">
  {
    hasToc && (
      <div
        id="fabTocPanel"
        class="hidden w-80 max-h-[70vh] overflow-y-auto rounded-2xl shadow-xl border border-(--md-outline-variant)/50 backdrop-blur-xl fab-panel"
      >
        <FloatingTocCard headings={headings} />
      </div>
    )
  }
  {
    hasGraph && (
      <div
        id="fabGraphPanel"
        class="hidden w-80 rounded-2xl shadow-xl border border-(--md-outline-variant)/50 backdrop-blur-xl [&_h4]:hidden fab-panel"
      >
        <FloatingGraphCard
          nodes={graphNodes}
          edges={graphEdges ?? []}
          currentSlug={currentSlug}
        />
      </div>
    )
  }

  <div id="fabGroup" class="flex flex-col gap-3 items-end">
    {
      hasGraph && (
        <button
          id="fabGraphBtn"
          class="lg:hidden w-11 h-11 rounded-xl bg-(--md-surface-container-lowest) shadow-[0_4px_16px_rgba(0,0,0,0.08)] border border-(--md-outline-variant) flex items-center justify-center text-(--md-on-surface-variant) hover:bg-(--md-primary-container) hover:text-(--md-primary) active:scale-90 transition-all duration-200"
          aria-label="图谱"
        >
          <span class="fi-default">
            <Icon name="mingcute:mind-map-line" class="w-5 h-5" />
          </span>
          <span class="fi-close hidden">
            <Icon name="mingcute:close-line" class="w-5 h-5" />
          </span>
        </button>
      )
    }
    {
      hasToc && (
        <button
          id="fabTocBtn"
          class="lg:hidden w-11 h-11 rounded-xl bg-(--md-surface-container-lowest) shadow-[0_4px_16px_rgba(0,0,0,0.08)] border border-(--md-outline-variant) flex items-center justify-center text-(--md-on-surface-variant) hover:bg-(--md-primary-container) hover:text-(--md-primary) active:scale-90 transition-all duration-200"
          aria-label="目录"
        >
          <span class="fi-default">
            <Icon name="mingcute:paragraph-line" class="w-5 h-5" />
          </span>
          <span class="fi-close hidden">
            <Icon name="mingcute:close-line" class="w-5 h-5" />
          </span>
        </button>
      )
    }
    {
      showHome && (
        <a
          href="/"
          class="w-11 h-11 rounded-xl bg-(--md-surface-container-lowest) shadow-[0_4px_16px_rgba(0,0,0,0.08)] border border-(--md-outline-variant) flex items-center justify-center text-(--md-on-surface-variant) hover:bg-(--md-primary-container) hover:text-(--md-primary) active:scale-90 transition-all duration-200"
          aria-label="返回首页"
        >
          <Icon name="mingcute:home-1-line" class="w-5 h-5" />
        </a>
      )
    }
    <!-- 回到顶部：用 wrapper 折叠展开，pb-4 给阴影留空间 -->
    <div
      id="backToTopWrap"
      class="overflow-hidden transition-all duration-300 ease-out"
      style="max-height: 0; opacity: 0;"
    >
      <div id="backToTopInner" class="pb-4">
        <button
          id="backToTopBtn"
          class="w-11 h-11 rounded-xl bg-(--md-surface-container-lowest) border border-(--md-outline-variant)/60 flex items-center justify-center text-(--md-on-surface-variant) hover:bg-(--md-primary-container) hover:text-(--md-primary) active:scale-90 transition-all duration-200"
          aria-label="回到顶部"
        >
          <Icon name="mingcute:arrow-up-line" class="w-5 h-5" />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .btf-slide-in {
    animation: btf-slide-up 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes btf-slide-up {
    from {
      transform: translateY(16px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script>
  let scrollHandler: (() => void) | null = null;

  function initFab() {
    const container = document.querySelector(".fixed.right-4.bottom-6.z-50");
    if (!container) return;

    if (scrollHandler) window.removeEventListener("scroll", scrollHandler);

    const topWrap = document.getElementById("backToTopWrap");
    const topInner = document.getElementById("backToTopInner");
    scrollHandler = () => {
      const show = window.scrollY > 400;
      if (!topWrap) return;
      topWrap.style.maxHeight = show ? "5rem" : "0";
      topWrap.style.opacity = show ? "1" : "0";
      if (topInner) {
        if (show) {
          topInner.classList.add("btf-slide-in");
        } else {
          topInner.classList.remove("btf-slide-in");
        }
      }
    };
    window.addEventListener("scroll", scrollHandler, { passive: true });
    scrollHandler();

    container
      .querySelector("#backToTopBtn")
      ?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" }),
      );

    let active: string | null = null;

    function toggle(id: string) {
      const btn = document.getElementById(id);
      const panel = document.getElementById(id.replace("Btn", "Panel"));
      if (!btn || !panel) return;
      const open = !panel.classList.contains("hidden");

      if (active && active !== id) {
        const p = document.getElementById(active.replace("Btn", "Panel"));
        const b = document.getElementById(active);
        if (p && b) {
          b.querySelector(".fi-default")?.classList.remove("hidden");
          b.querySelector(".fi-close")?.classList.add("hidden");
          p.classList.add("hidden");
        }
      }

      if (open) {
        btn.querySelector(".fi-default")?.classList.remove("hidden");
        btn.querySelector(".fi-close")?.classList.add("hidden");
        panel.classList.add("hidden");
        active = null;
      } else {
        btn.querySelector(".fi-default")?.classList.add("hidden");
        btn.querySelector(".fi-close")?.classList.remove("hidden");
        panel.classList.remove("hidden");
        setTimeout(
          () => document.dispatchEvent(new Event("astro:page-load")),
          150,
        );
        active = id;
      }
    }

    document
      .getElementById("fabTocBtn")
      ?.addEventListener("click", () => toggle("fabTocBtn"));
    document
      .getElementById("fabGraphBtn")
      ?.addEventListener("click", () => toggle("fabGraphBtn"));

    document.addEventListener("click", (e) => {
      if (!active) return;
      const t = e.target as Node;
      const b = document.getElementById(active);
      const p = document.getElementById(active.replace("Btn", "Panel"));
      if (b?.contains(t) || p?.contains(t)) return;
      toggle(active);
    });
  }

  initFab();
  document.addEventListener("astro:after-swap", initFab);
</script>
