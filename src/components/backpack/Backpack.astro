---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  items: {
    title: string;
    description: string;
    year: number;
    status: string;
    image?: ImageMetadata | null;
    slug: string;
    reason?: string;
  }[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  {items.map((item, i) => (
    <a
      href={`/backpack/${item.slug}`}
      class="group card overflow-hidden relative animate-fade-up
        border border-(--md-outline-variant)/40
        hover:shadow-md hover:shadow-(--md-primary)/5
        hover:border-(--md-primary)/20
        transition-all duration-300"
      style={`animation-delay: ${i * 60}ms`}
    >
      <div class="flex items-center gap-4 p-4">
        <!-- 图片 -->
        {item.image && (
          <div
            class="shrink-0 w-20 h-20 md:w-24 md:h-24 rounded-lg overflow-hidden
            bg-(--md-surface-container-low) flex items-center justify-center
            transition-colors duration-300
            group-hover:bg-(--md-primary-container)/40"
          >
            <Image
              src={item.image}
              alt={item.title}
              width={96}
              height={96}
              class="w-full h-full object-cover
                transition-transform duration-500
                group-hover:scale-110"
            />
          </div>
        )}

        <!-- 文字区 -->
        <div class="flex-1 min-w-0">
          <!-- 标题行 -->
          <div class="flex items-start justify-between gap-1.5">
            <h3
              class="font-semibold text-sm md:text-base text-(--md-on-surface) leading-snug
              group-hover:text-(--md-primary) transition-colors duration-300"
            >
              {item.title}
            </h3>
            <span
              class="shrink-0 text-[11px] font-medium
              text-(--md-on-surface-variant)/80
              px-1.5 py-0.5 rounded-md
              bg-(--md-surface-container-low)
              whitespace-nowrap"
            >
              {item.year}
            </span>
          </div>

          <!-- 描述 -->
          <p class="mt-1 text-xs md:text-sm text-(--md-on-surface-variant) leading-relaxed line-clamp-2">
            {item.description}
          </p>

          <!-- 底部行 -->
          <div class="flex items-center justify-between mt-2">
            {item.reason ? (
              <span class="text-[11px] text-(--md-on-surface-variant)/45 truncate mr-2">
                {item.reason}
              </span>
            ) : (
              <span class="text-[11px] text-(--md-on-surface-variant)/25 truncate mr-2">
                状态更新中...
              </span>
            )}

            {item.status === "使用中" ? (
              <span
                class="shrink-0 text-[11px] font-medium px-1.5 py-0.5 rounded-md
                bg-(--md-primary-container)/70 text-(--md-on-primary-container)"
              >
                使用中
              </span>
            ) : (
              <span
                class="shrink-0 text-[11px] font-medium px-1.5 py-0.5 rounded-md
                bg-(--md-surface-container-low) text-(--md-outline)"
              >
                闲置
              </span>
            )}
          </div>
        </div>
      </div>
    </a>
  ))}
</div>
